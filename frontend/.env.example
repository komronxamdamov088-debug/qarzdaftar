NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Bot username only (no leading @), used to build t.me/<username>?startapp=...
# deep links (e.g. the "link customer to Telegram" button on a debt's page).
# Not a secret — matches backend's TELEGRAM_BOT_USERNAME.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# Where the subscription "Onlayn to'lov" picker sends a shop when they tap
# a provider — no real Click/Payme/Yagona Pay merchant checkout exists yet,
# so this just opens that provider's own app/site for a manual transfer.
# Click/Payme default to their well-known official domains if left unset;
# Yagona Pay has no known public app URL yet, so it stays disabled until set.
NEXT_PUBLIC_CLICK_APP_URL=
NEXT_PUBLIC_PAYME_APP_URL=
NEXT_PUBLIC_YAGONA_PAY_APP_URL=
