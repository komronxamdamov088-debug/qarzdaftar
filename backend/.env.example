PORT=4000
NODE_ENV=development

# Comma-separated list of allowed frontend origins (e.g.
# https://app.qarzdaftar.uz,https://qarzdaftar.uz). Required in production —
# /debts/confirm/:token is called directly from the browser, so this must
# include every origin the frontend is deployed at. Leave unset in local dev
# to allow any origin.
CORS_ORIGINS=

DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

JWT_SECRET=

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Google Gemini API key (https://ai.google.dev) — used for AI-generated debt reminders.
AI_API_KEY=

# Backend-side return-url base for payment-provider checkout redirects
# (distinct from the frontend's own NEXT_PUBLIC_APP_URL — this is read
# server-side only). e.g. https://qarzdaftar-tau.vercel.app
FRONTEND_URL=

# Click Merchant API (https://docs.click.uz) — leave unset to keep the Click
# checkout button visibly present but returning a clear "not configured"
# error (never a fake success), same pattern as AI_API_KEY.
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
CLICK_CHECKOUT_BASE_URL=

# Payme Merchant API (https://developer.help.paycom.uz)
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_CHECKOUT_BASE_URL=

# Yagona Pay — field names are PROVISIONAL (less-documented aggregator);
# verify against real docs/credentials before going live.
YAGONA_PAY_MERCHANT_ID=
YAGONA_PAY_SECRET_KEY=
YAGONA_PAY_CHECKOUT_BASE_URL=
YAGONA_PAY_API_BASE_URL=
