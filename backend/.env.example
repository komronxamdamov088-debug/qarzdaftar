PORT=4000
NODE_ENV=development

# Comma-separated list of allowed frontend origins (e.g.
# https://app.qarzdaftar.uz,https://qarzdaftar.uz). Required in production —
# /debts/confirm/:token is called directly from the browser, so this must
# include every origin the frontend is deployed at. Leave unset in local dev
# to allow any origin.
CORS_ORIGINS=

DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

JWT_SECRET=

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Google Gemini API key (https://ai.google.dev) — used for AI-generated debt reminders.
AI_API_KEY=
